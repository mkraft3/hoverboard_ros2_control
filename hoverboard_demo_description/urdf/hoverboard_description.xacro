<?xml version="1.0"?>
<robot name="hoverboard_robot" xmlns:xacro="http://ros.org/wiki/xacro">

    <xacro:include filename="materials.xacro" />
    <xacro:include filename="macros.xacro" />
    <xacro:include filename="wheels.xacro" />
    <xacro:include filename="ros2_control.xacro" />

    <xacro:property name="plate_length" value="1.70" />  <!-- in Fahrtrichtung (x) -->
    <xacro:property name="plate_width"  value="0.70" />  <!-- quer (y) -->
    <xacro:property name="plate_height" value="1.04" />
    <xacro:property name="plate_weight" value="125.5" />

    <xacro:property name="chassis_weight" value="1.0" />

    <xacro:property name="driving_wheel_diameter" value="0.250" />
    <xacro:property name="driving_wheel_thickness" value="0.045" />
    <xacro:property name="driving_wheel_weight" value="2.2" />
    <xacro:property name="driving_wheel_base_gap" value="0.01" />

    <xacro:property name="caster_wheel_diameter" value="0.2" />
    <xacro:property name="caster_wheel_weight" value="0.1" />

    <link name="base_link">
    </link>

    <link name="plate">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 -${pi/2}"/>
            <geometry>
                <mesh filename="package://hoverboard_demo_description/meshes/rover.stl" scale="0.001 0.001 0.001"/>
            </geometry>
            <material name="gray"/>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <geometry>
                <box size="${plate_length} ${plate_width} ${plate_height}"/>
            </geometry>
        </collision>
        <xacro:box_inertia m="${plate_weight}" x="${plate_length}" y="${plate_width}" z="${plate_height}"/>
    </link>

    <joint name="base_link_plate_joint" type="fixed">
        <origin rpy="0 0 0" xyz="0 0 0" />
        <parent link="base_link" />
        <child link="plate" />
    </joint>

    <!-- Lidar: Name muss dem frame_id von rplidar_ros entsprechen (Standard "laser") -->
    <link name="laser">
    </link>

    <joint name="base_link_laser_joint" type="fixed">
        <!-- ANPASSEN: Position des Lidar-Drehzentrums relativ zu base_link (Radachsen-Mitte) nachmessen -->
        <origin xyz="0 0 0.10" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="laser" />
    </joint>

    <xacro:driving_wheel suffix="left" reflect="1"/>
    <xacro:driving_wheel suffix="right" reflect="-1"/>

    <xacro:caster_wheel suffix="front" reflect="1" />
    <xacro:caster_wheel suffix="back" reflect="-1" />

    <xacro:hoverboard_ros2_control name="Hoverboard" />

</robot>
